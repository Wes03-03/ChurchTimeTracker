<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LogicSmoke</AssemblyName>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <EnableMauiAssetProcessing>false</EnableMauiAssetProcessing>
    <EnableMauiSplashScreenProcessing>false</EnableMauiSplashScreenProcessing>
    <EnableMauiFontProcessing>false</EnableMauiFontProcessing>
    <EnableMauiImageProcessing>false</EnableMauiImageProcessing>
    <ResizetizerErrorOnDuplicateOutputFilename>false</ResizetizerErrorOnDuplicateOutputFilename>
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ChurchTimeTracker.csproj" />
    <MauiIcon Remove="..\..\Resources\AppIcon\**\*" />
    <MauiSplashScreen Remove="..\..\Resources\Splash\**\*" />
    <MauiFont Remove="..\..\Resources\Fonts\**\*" />
  </ItemGroup>
</Project>
