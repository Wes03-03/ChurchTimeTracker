<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChurchTimeTracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Brand">#285E61</Color>
            <Color x:Key="BrandDark">#78C6C7</Color>
            <Color x:Key="BrandSoft">#E3F0EF</Color>
            <Color x:Key="Accent">#D88C35</Color>
            <Color x:Key="Success">#2F7D5C</Color>
            <Color x:Key="Danger">#B34A4A</Color>
            <Color x:Key="LightCanvas">#F3F6F5</Color>
            <Color x:Key="DarkCanvas">#111817</Color>
            <Color x:Key="LightSurface">#FFFFFF</Color>
            <Color x:Key="DarkSurface">#1A2422</Color>
            <Color x:Key="LightText">#172321</Color>
            <Color x:Key="DarkText">#F1F7F5</Color>
            <Color x:Key="LightMuted">#64726F</Color>
            <Color x:Key="DarkMuted">#A9B8B4</Color>
            <Color x:Key="LightBorder">#DCE5E2</Color>
            <Color x:Key="DarkBorder">#34423F</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightCanvas}, Dark={StaticResource DarkCanvas}}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
            </Style>
            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="30" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="19" />
            </Style>
            <Style x:Key="MutedText" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#14000000" Offset="0,3" Radius="12" Opacity="0.35" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,11" />
                <Setter Property="MinimumHeightRequest" Value="46" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters><Setter Property="Opacity" Value="0.9" /></VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters><Setter Property="Opacity" Value="0.42" /></VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E6EEEC, Dark=#2B3936}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource DarkText}}" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Brand}" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="MinimumHeightRequest" Value="46" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="MinimumHeightRequest" Value="46" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="MinimumHeightRequest" Value="46" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
