<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ChurchTimeTracker.Pages"
       x:Class="ChurchTimeTracker.AppShell"
       Title="Church Time Tracker"
       FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A2422}"
       Shell.ForegroundColor="#285E61"
       Shell.TitleColor="{AppThemeBinding Light=#172321, Dark=#F1F7F5}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A2422}"
       Shell.TabBarForegroundColor="{AppThemeBinding Light=#285E61, Dark=#78C6C7}"
       Shell.TabBarTitleColor="{AppThemeBinding Light=#285E61, Dark=#78C6C7}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light=#71807C, Dark=#A9B8B4}">
    <TabBar>
        <ShellContent Title="Timer" Route="timer" ContentTemplate="{DataTemplate pages:TimerPage}" />
        <ShellContent Title="Categories" Route="categories" ContentTemplate="{DataTemplate pages:SetupPage}" />
        <ShellContent Title="Reports" Route="reports" ContentTemplate="{DataTemplate pages:OverviewPage}" />
    </TabBar>
</Shell>
